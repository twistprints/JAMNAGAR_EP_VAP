# Database configuration (SQLite default, or PostgreSQL/Supabase)
DATABASE_URL="file:./jamnagar_pass.db"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudflare R2 Storage (S3-Compatible Object Storage)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="jamnagar-documents"

# JWT Secret for persistent authentication
JWT_SECRET="your_jwt_secret_key_change_in_production"

# Gemini API Key (Required for server-side Gemini Vision OCR extraction)
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini Vision Model (e.g. gemini-3.8-flash, gemini-3.5-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Document Storage Path
STORAGE_DIR="./uploads/JAMNAGAR"

# Server Port
PORT=3000
